# Puerto COM donde está conectado el Arduino
# Windows: COM3, COM4, etc.
# Linux/macOS: /dev/ttyUSB0, /dev/ttyACM0, etc.
COM_PORT=COM3

# Velocidad del puerto serial (debe coincidir con el firmware)
BAUD_RATE=9600

# URL base del backend en la nube
API_URL=https://colina-real-api.onrender.com

# Clave de autenticación para el backend (generar con: openssl rand -hex 32)
API_KEY=change_me_to_a_secure_random_key

# Identificador único de este bridge (útil para multi-tienda)
BRIDGE_ID=bridge-colina-real-01

# Intervalo de reintento para eventos en cola (ms)
RETRY_INTERVAL_MS=30000

# Máximo de eventos acumulados en cola offline
MAX_QUEUE_SIZE=1000

# Nivel de log: error | warn | info | debug
LOG_LEVEL=info
