# Puerto COM donde está conectado el Arduino (OPCIONAL — si se omite, se auto-detecta)
# El bridge busca automáticamente por VID/PID: Arduino SA (2341), CH340 (1a86), FTDI (0403), CP210x (10c4)
# Solo descomenta y ajusta esta línea si la auto-detección falla o tienes varios dispositivos conectados.
# Windows: COM3, COM4, etc. | Linux/macOS: /dev/ttyUSB0, /dev/ttyACM0, etc.
# COM_PORT=COM3

# Velocidad del puerto serial (debe coincidir con BAUD_SERIAL del firmware: 115200 bps)
BAUD_RATE=115200

# URL base del backend en la nube
API_URL=https://colina-real-api.onrender.com

# Clave de autenticación para el backend (generar con: openssl rand -hex 32)
API_KEY=change_me_to_a_secure_random_key

# Identificador único de este bridge (útil para multi-tienda)
BRIDGE_ID=bridge-colina-real-01

# Intervalo de reintento para eventos en cola (ms)
RETRY_INTERVAL_MS=30000

# Máximo de eventos acumulados en cola offline
MAX_QUEUE_SIZE=1000

# Nivel de log: error | warn | info | debug
LOG_LEVEL=info
