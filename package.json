{
  "name": "iot-colina-real",
  "version": "1.0.0",
  "description": "Sistema IoT de Inventario y Punto de Venta - Impresiones Colina Real",
  "private": true,
  "workspaces": [
    "bridge-local",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "bridge": "npm run start --workspace=bridge-local",
    "backend:dev": "npm run start:dev --workspace=backend",
    "frontend:dev": "npm run start --workspace=frontend",
    "backend:build": "npm run build --workspace=backend",
    "frontend:build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "author": "Impresiones Colina Real - PAS 2026",
  "license": "MIT",
  "devDependencies": {
    "@angular/common": "17.3.12",
    "@angular/core": "17.3.12",
    "@nestjs/common": "^10.3.8",
    "@nestjs/core": "^10.3.8",
    "caniuse-lite": "^1.0.30001782",
    "typescript": "5.4.5"
  },
  "overrides": {
    "@types/node": "20.12.7",
    "@angular/animations": "17.3.12",
    "@angular/common": "17.3.12",
    "@angular/compiler": "17.3.12",
    "@angular/compiler-cli": "17.3.12",
    "@angular/core": "17.3.12",
    "@angular/forms": "17.3.12",
    "@angular/platform-browser": "17.3.12",
    "@angular/platform-browser-dynamic": "17.3.12",
    "@angular/router": "17.3.12"
  },
  "dependencies": {
    "pg": "^8.21.0",
    "typeorm": "^0.3.20",
    "uuid": "^14.0.0"
  }
}
