# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/colina_real

# Puerto del servidor
PORT=3000

# Entorno
NODE_ENV=development

# Clave secreta para autenticar el bridge-local
# Debe coincidir con API_KEY en el .env del bridge-local
API_KEY=change_me_to_a_secure_random_key

# CORS: URL del frontend (separar con coma para múltiples)
CORS_ORIGINS=http://localhost:4200,https://colina-real.netlify.app

# Stock mínimo global por defecto (se puede sobreescribir por producto)
DEFAULT_MIN_STOCK=5
